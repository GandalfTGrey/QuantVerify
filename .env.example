# Secrets belong in a local .env file or a secret manager, never in Git.
QUANTVERIFY_LOG_LEVEL=INFO
QUANTVERIFY_DATA_DIR=./data
QUANTVERIFY_ARTIFACT_DIR=./artifacts
TUSHARE_TOKEN=
# Provider-specific endpoint used by local Tushare access. Keep credentials in .env.
TUSHARE_HTTP_URL=http://jiaoch.site

# Massive (formerly Polygon) market-data API credentials.
MASSIVE_API_KEY=
